{
  "name": "@ripple-design/icons",
  "version": "1.1.0",
  "description": "Framework-agnostic icon path data generated from Ripple Icons SVG assets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ripple-Design/ripple-icons.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./filled": {
      "types": "./dist/filled/index.d.ts",
      "import": "./dist/filled/index.js"
    },
    "./outlined": {
      "types": "./dist/outlined/index.d.ts",
      "import": "./dist/outlined/index.js"
    },
    "./rounded": {
      "types": "./dist/rounded/index.d.ts",
      "import": "./dist/rounded/index.js"
    },
    "./sharp": {
      "types": "./dist/sharp/index.d.ts",
      "import": "./dist/sharp/index.js"
    },
    "./twotone": {
      "types": "./dist/twotone/index.d.ts",
      "import": "./dist/twotone/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "generate": "node ./scripts/generate-icons.mjs",
    "build": "npm run generate && npm run build:bundle",
    "build:bundle": "node ./scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "svgo": "^4.0.2"
  }
}
